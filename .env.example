# Copy this file to .env and replace placeholders with local values.
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost,http://localhost:5500
COOKIE_SECURE=false

ACADEMIC_DB_PASSWORD=replace-with-a-strong-local-password
PG_POOL_SIZE=5
PG_MAX_OVERFLOW=5

LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Oracle Cloud deployment (docker-compose.oracle.yml)
APP_DOMAIN=your-subdomain.duckdns.org
ACME_EMAIL=you@example.com
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
MYSQL_USER=dpniti_user
MYSQL_PASSWORD=replace-with-another-long-random-password
